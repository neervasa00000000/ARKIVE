{
  "name": "arkive-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -n vite,sponsor -c cyan,magenta \"vite\" \"npm run sponsor-server\"",
    "sponsor-server": "node server/turboSponsor.mjs",
    "build": "node scripts/check-production-env.mjs && vite build",
    "preview": "vite preview",
    "deploy:arweave": "npm run build && node scripts/deploy-to-arweave.js",
    "test:security": "node --test tests/security.test.mjs tests/turbo-credits.test.mjs tests/sponsor-upload.test.mjs"
  },
  "dependencies": {
    "@ardrive/turbo-sdk": "^1.0.0",
    "@dha-team/arbundles": "^1.0.1",
    "@lit-protocol/constants": "^6.0.0",
    "@lit-protocol/lit-node-client": "^6.0.0",
    "@lit-protocol/uint8arrays": "^6.0.0",
    "@rainbow-me/rainbowkit": "^2.0.0",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.7.0",
    "lucide-react": "^0.383.0",
    "process": "^0.11.10",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hot-toast": "^2.4.0",
    "react-router-dom": "^6.26.0",
    "viem": "^2.0.0",
    "wagmi": "^2.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.0",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
