# Local Ollama only for "Suggest title & tags". Never add cloud LLM API keys.
# Configure the model in Profile → Local suggestions. Default: qwen2.5:7b at http://127.0.0.1:11434

# Copy to .env and fill in

# Demo mode — MUST be false for production builds (npm run build enforces this)
VITE_DEMO_MODE=false


VITE_WALLETCONNECT_PROJECT_ID=get_from_walletconnect_cloud

# Sponsor API — required for production (static hosts have no /api proxy)
# Dev: leave unset (Vite proxies /api/turbo to localhost:8787)
# Beta: https://your-sponsor.railway.app (no trailing slash)
VITE_SPONSOR_API_URL=

# Arweave permaweb deploy TX IDs (public — safe in bundle; filled after npm run deploy:arweave)
VITE_ARWEAVE_APP_TX=your_app_manifest_tx_id_here
VITE_ARWEAVE_RECOVERY_TX=your_recovery_guide_tx_id_here

# Contract addresses (optional — defaults in src/config/contracts.js on Base Sepolia)
VITE_POST_REGISTRY=0x...
VITE_VAULT_REGISTRY=0x...
VITE_USER_REGISTRY=0x...
VITE_POINTS_SYSTEM=0x...
VITE_WALLET_LINKER=0x...

# --- Deploy script only (Node.js) — NEVER prefix with VITE_ ---
# Used only by: npm run deploy:arweave (uploads frontend dist to permaweb)
# ARWEAVE_DEPLOY_KEY={"kty":"RSA",...}

# Testnet infrastructure. Payment and upload MUST belong to the same testnet.
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
VITE_TURBO_PAYMENT_URL=https://payment.services.ar-io.dev
VITE_TURBO_UPLOAD_URL=https://upload.services.ar-io.dev
# Optional retrieval gateway for your storage testnet (without transaction ID).
VITE_STORAGE_GATEWAY_URL=

# Local sponsor prototype only; never reuse the contract deployer key.
# Disabled on public deployments until durable abuse controls are implemented.
SPONSOR_ENABLED=false
# SPONSOR_PRIVATE_KEY=
