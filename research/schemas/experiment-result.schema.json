{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkive.example/research/experiment-result.schema.json",
  "title": "ARKIVE recovery dependency experiment result",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment", "description", "timestamp", "gitCommit", "gitDirty", "fixture", "removedDependencies", "availableDependencies", "expectedOutcome", "actualOutcome", "externalEndpointsContacted", "durationMs", "result"],
  "properties": {
    "experiment": { "type": "string", "pattern": "^E(0[1-9]|1[0-3])$" },
    "description": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "gitDirty": { "type": "boolean" },
    "fixture": { "type": "string" },
    "fixtureArchiveSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "ciphertextSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "transactionStorageIdentifier": { "type": ["string", "null"] },
    "removedDependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "availableDependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "expectedOutcome": { "type": "string" },
    "actualOutcome": { "enum": ["RECOVERY_SUCCESS", "RECOVERY_REJECTED", "NOT_IMPLEMENTED", "ENVIRONMENT_UNAVAILABLE"] },
    "errorClassification": { "type": ["string", "null"] },
    "expectedPlaintextSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "recoveredPlaintextSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "exactByteMatch": { "type": ["boolean", "null"] },
    "stage": { "type": "string" },
    "gatewayA": { "type": ["string", "null"] },
    "gatewayB": { "type": ["string", "null"] },
    "gatewayBIndependentOperatorEstablished": { "type": "boolean" },
    "retrievedArchiveASha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "retrievedArchiveBSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "primaryStorageAvailable": { "type": "boolean" },
    "replicaAvailable": { "type": "boolean" },
    "accessedLocations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "primaryArchiveSha256BeforeRemoval": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "replicaArchiveSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "claimBoundary": { "type": "string" },
    "excludedClaim": { "type": "string" },
    "specificationConformance": { "enum": ["PASS", "FAIL"] },
    "nodeConformance": { "type": "object" },
    "pythonConformance": { "type": "object" },
    "independentSpecificationOnlyReimplementation": { "enum": ["NOT VALIDATED"] },
    "limitation": { "type": "string" },
    "externalEndpointsContacted": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "durationMs": { "type": "integer", "minimum": 0 },
    "result": { "enum": ["PASS", "FAIL", "NOT VALIDATED", "SKIPPED"] }
  }
}
